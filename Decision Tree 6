library(rpart)
library(rpart.plot)
Spam <- read.csv()
model <- rpart(Spam ~ Email_len + links, 
               data = Spam, 
               method = "class", 
               control = rpart.control(cp=0.001, minsplit=2)
)
rpart.lot(model, type = 2, fallen.leaves = FALSE)



